---
import SEO from '@/components/shared/SEO.astro';
import { LOCALES, DEFAULT_LOCALE, getAlternatePath } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  locale: 'de' | 'en';
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: Record<string, any>[];
}

const { title, description, locale, image, canonical, type, jsonLd } = Astro.props;
const currentPath = Astro.url.pathname;

const BUILD_VERSION = Date.now().toString(36);
---

<!DOCTYPE html>
<html lang={locale} class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="build-version" content={BUILD_VERSION} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/images/og-default.svg" />
  <SEO title={title} description={description} locale={locale} image={image} canonical={canonical} type={type} jsonLd={jsonLd} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <script>
    const meta = document.querySelector('meta[name="build-version"]');
    const currentVersion = meta ? meta.getAttribute('content') : null;
    const storedVersion = localStorage.getItem('site-build-version');
    const hasVersionParam = /[?&]v=/.test(window.location.search);

    if (currentVersion && currentVersion !== storedVersion && !hasVersionParam) {
      const url = new URL(window.location.href);
      url.searchParams.set('v', currentVersion);
      window.location.replace(url.toString());
    } else if (!storedVersion) {
      localStorage.setItem('site-build-version', currentVersion);
    } else if (storedVersion !== currentVersion) {
      localStorage.setItem('site-build-version', currentVersion);
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-neutral-50 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-50 font-sans antialiased">
  <a href="#main" class="skip-link">
    {locale === 'de' ? 'Zum Hauptinhalt springen' : 'Skip to main content'}
  </a>
  <div class="flex flex-col min-h-screen">
    <slot />
  </div>
</body>
</html>
