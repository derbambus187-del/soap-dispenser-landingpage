---
import { icons } from 'lucide';

interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: number;
  'aria-label'?: string;
}

const { name, size = 20, class: className = '', stroke = 1.5, 'aria-label': ariaLabel } = Astro.props;
const aria = ariaLabel || name;
const ariaHidden = !ariaLabel ? 'true' : 'false';
const iconFn = icons[name as keyof typeof icons];
const svgString = iconFn ? iconFn.toString() : '';
---

<span
  class={className}
  aria-label={aria}
  aria-hidden={ariaHidden}
  innerHTML={svgString}
  style={{ display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: `${size}px`, height: `${size}px` }}
></span>

<style>
  span svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
