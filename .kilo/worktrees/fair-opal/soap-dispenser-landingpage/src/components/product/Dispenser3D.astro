---
import { cx } from 'class-variance-authority';

interface Props {
  locale: 'de' | 'en';
  class?: string;
}

const { locale, class: className } = Astro.props;
const id = `dispenser-3d-${Math.random().toString(36).slice(2, 9)}`;
const instructions = locale === 'de'
  ? 'Ziehen zum Drehen · Scrollen zum Zoomen · Rechtsklick zum Verschieben'
  : 'Drag to rotate · Scroll to zoom · Right-click to pan';
const ariaLabel = locale === 'de'
  ? 'Interaktives 3D-Modell des 3-in-1 Seifenspenders'
  : 'Interactive 3D model of the 3-in-1 soap dispenser';
---

<div
  id={id}
  class={cx('relative w-full aspect-square max-w-md mx-auto', className)}
  data-dispenser-3d
  data-locale={locale}
  data-loaded="false"
>
  <!-- Loading skeleton -->
  <div
    class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-white/60 dark:bg-neutral-900/60 backdrop-blur-sm rounded-none transition-opacity duration-300"
    data-3d-skeleton
  >
    <div class="w-32 h-32 rounded-full border-4 border-brand-200 dark:border-brand-800 border-t-brand-600 dark:border-t-brand-400 animate-[spin_1s_linear_infinite] mb-4" />
    <p class="text-body-sm text-neutral-500 dark:text-neutral-400 font-medium animate-pulse">
      {locale === 'de' ? '3D-Modell wird geladen…' : 'Loading 3D model…'}
    </p>
  </div>

  <canvas class="w-full h-full opacity-0 transition-opacity duration-500" aria-label={ariaLabel}></canvas>
  <div class="absolute bottom-4 left-4 right-4 text-center pointer-events-none">
    <p class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">{instructions}</p>
  </div>
</div>

<script type="module">
  import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js';
  import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/controls/OrbitControls.js';

  const container = document.currentScript?.closest('[data-dispenser-3d]');
  if (!container) throw new Error('Dispenser3D container not found');

  const canvas = container.querySelector('canvas');
  if (!canvas) throw new Error('Dispenser3D canvas not found');

  const skeleton = container.querySelector('[data-3d-skeleton]');

  // Scene setup
  const scene = new THREE.Scene();
  scene.background = null;

  // Renderer
  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: true,
    alpha: true,
    preserveDrawingBuffer: true,
  });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.1;
  renderer.outputColorSpace = THREE.SRGBColorSpace;

  // Camera
  const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
  camera.position.set(0, 1.2, 2.8);

  // Controls
  const controls = new OrbitControls(camera, canvas);
  controls.enableDamping = true;
  controls.dampingFactor = 0.05;
  controls.enablePan = true;
  controls.minDistance = 1.5;
  controls.maxDistance = 5;
  controls.maxPolarAngle = Math.PI / 1.8;
  controls.minPolarAngle = 0.15;
  controls.target.set(0, 0.8, 0);
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.3;

  // Lighting
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambientLight);

  const keyLight = new THREE.DirectionalLight(0xffffee, 2.5);
  keyLight.position.set(3, 5, 4);
  keyLight.castShadow = true;
  keyLight.shadow.mapSize.width = 2048;
  keyLight.shadow.mapSize.height = 2048;
  keyLight.shadow.camera.near = 0.5;
  keyLight.shadow.camera.far = 15;
  keyLight.shadow.camera.left = -3;
  keyLight.shadow.camera.right = 3;
  keyLight.shadow.camera.top = 3;
  keyLight.shadow.camera.bottom = -3;
  keyLight.shadow.bias = -0.001;
  scene.add(keyLight);

  const fillLight = new THREE.DirectionalLight(0x88ccff, 0.8);
  fillLight.position.set(-4, 2, 3);
  scene.add(fillLight);

  const rimLight = new THREE.DirectionalLight(0xfff8ee, 1.2);
  rimLight.position.set(0, -3, -5);
  scene.add(rimLight);

  // Materials
  const matteWhite = new THREE.MeshPhysicalMaterial({
    color: 0xfafafa,
    roughness: 0.85,
    metalness: 0.0,
    clearcoat: 0.05,
    clearcoatRoughness: 0.2,
  });

  const matteDark = new THREE.MeshPhysicalMaterial({
    color: 0x1a1a1a,
    roughness: 0.9,
    metalness: 0.0,
  });

  const brushedAlu = new THREE.MeshPhysicalMaterial({
    color: 0xc8c8c8,
    roughness: 0.4,
    metalness: 0.95,
    clearcoat: 0.3,
    clearcoatRoughness: 0.3,
  });

  const chrome = new THREE.MeshPhysicalMaterial({
    color: 0xffffff,
    roughness: 0.02,
    metalness: 1.0,
  });

  const glass = new THREE.MeshPhysicalMaterial({
    color: 0xffffff,
    roughness: 0.05,
    metalness: 0.0,
    transmission: 0.92,
    thickness: 2,
    ior: 1.52,
    transparent: true,
    opacity: 1,
  });

  const liquidSoap = new THREE.MeshPhysicalMaterial({
    color: 0x475569,
    roughness: 0.3,
    metalness: 0.0,
    transmission: 0.7,
    thickness: 2,
    ior: 1.38,
    transparent: true,
  });

  const liquidFoam = new THREE.MeshPhysicalMaterial({
    color: 0xc2410c,
    roughness: 0.4,
    metalness: 0.0,
    transmission: 0.5,
    thickness: 2,
    ior: 1.25,
    transparent: true,
  });

  const liquidPaste = new THREE.MeshPhysicalMaterial({
    color: 0xd97706,
    roughness: 0.35,
    metalness: 0.0,
    transmission: 0.6,
    thickness: 2,
    ior: 1.45,
    transparent: true,
  });

  const blackPlastic = new THREE.MeshPhysicalMaterial({
    color: 0x0c0a09,
    roughness: 0.3,
    metalness: 0.0,
  });

  const ledOff = new THREE.MeshBasicMaterial({ color: 0x1a1a1a });
  const ledOn = new THREE.MeshBasicMaterial({ color: 0xd97706 });

  // Create dispenser geometry
  const dispenser = new THREE.Group();

  // Main body - rounded box
  const bodyHeight = 2.2;
  const bodyWidth = 1.0;
  const bodyDepth = 0.55;
  const cornerRadius = 0.08;

  const bodyShape = new THREE.Shape();
  const r = cornerRadius;
  bodyShape.moveTo(-bodyWidth / 2 + r, -bodyHeight / 2);
  bodyShape.lineTo(bodyWidth / 2 - r, -bodyHeight / 2);
  bodyShape.quadraticCurveTo(bodyWidth / 2, -bodyHeight / 2, bodyWidth / 2, -bodyHeight / 2 + r);
  bodyShape.lineTo(bodyWidth / 2, bodyHeight / 2 - r);
  bodyShape.quadraticCurveTo(bodyWidth / 2, bodyHeight / 2, bodyWidth / 2 - r, bodyHeight / 2);
  bodyShape.lineTo(-bodyWidth / 2 + r, bodyHeight / 2);
  bodyShape.quadraticCurveTo(-bodyWidth / 2, bodyHeight / 2, -bodyWidth / 2, bodyHeight / 2 - r);
  bodyShape.lineTo(-bodyWidth / 2, -bodyHeight / 2 + r);
  bodyShape.quadraticCurveTo(-bodyWidth / 2, -bodyHeight / 2, -bodyWidth / 2 + r, -bodyHeight / 2);

  const extrudeSettings = { depth: bodyDepth, bevelEnabled: false };
  const bodyGeom = new THREE.ExtrudeGeometry(bodyShape, extrudeSettings);
  bodyGeom.center();
  const body = new THREE.Mesh(bodyGeom, matteWhite);
  body.castShadow = true;
  body.receiveShadow = true;
  dispenser.add(body);

  // Chamber dividers (visual lines)
  const dividerGeom = new THREE.BoxGeometry(bodyWidth * 0.9, 0.008, bodyDepth * 0.95);
  const dividerMat = new THREE.MeshPhysicalMaterial({
    color: 0xffffff,
    roughness: 0.3,
    metalness: 0.1,
    transparent: true,
    opacity: 0.15,
  });
  for (let i = 1; i < 3; i++) {
    const divider = new THREE.Mesh(dividerGeom, dividerMat);
    divider.position.y = -bodyHeight / 2 + i * bodyHeight / 3;
    dispenser.add(divider);
  }

  // Cap top
  const capHeight = 0.18;
  const capShape = new THREE.Shape();
  capShape.moveTo(-bodyWidth / 2 + r, 0);
  capShape.lineTo(bodyWidth / 2 - r, 0);
  capShape.quadraticCurveTo(bodyWidth / 2, 0, bodyWidth / 2, r);
  capShape.lineTo(bodyWidth / 2, capHeight - r);
  capShape.quadraticCurveTo(bodyWidth / 2, capHeight, bodyWidth / 2 - r, capHeight);
  capShape.lineTo(-bodyWidth / 2 + r, capHeight);
  capShape.quadraticCurveTo(-bodyWidth / 2, capHeight, -bodyWidth / 2, capHeight - r);
  capShape.lineTo(-bodyWidth / 2, r);
  capShape.quadraticCurveTo(-bodyWidth / 2, 0, -bodyWidth / 2 + r, 0);

  const capGeom = new THREE.ExtrudeGeometry(capShape, { depth: bodyDepth, bevelEnabled: false });
  capGeom.center();
  const cap = new THREE.Mesh(capGeom, matteDark);
  cap.position.y = bodyHeight / 2 + capHeight / 2;
  cap.castShadow = true;
  dispenser.add(cap);

  // Sensor ring on cap
  const ringGeom = new THREE.TorusGeometry(0.12, 0.015, 16, 64);
  const ring = new THREE.Mesh(ringGeom, chrome);
  ring.position.set(0, bodyHeight / 2 + capHeight + 0.01, bodyDepth / 2 + 0.01);
  ring.rotation.x = -Math.PI / 2;
  dispenser.add(ring);

  // Status LED on cap
  const ledGeom = new THREE.CylinderGeometry(0.04, 0.04, 0.01, 32);
  const led = new THREE.Mesh(ledGeom, ledOn);
  led.position.set(0, bodyHeight / 2 + capHeight + 0.015, bodyDepth / 2 + 0.02);
  dispenser.add(led);

  // Chambers (3 chambers with liquids)
  const chamberHeight = bodyHeight / 3 - 0.04;
  const chamberWidth = bodyWidth * 0.75;
  const chamberDepth = bodyDepth * 0.65;
  const wallThickness = 0.025;

  const chamberMaterials = [liquidSoap, liquidFoam, liquidPaste];
  const fillLevels = [0.78, 0.62, 0.82];

  for (let i = 0; i < 3; i++) {
    const y = -bodyHeight / 2 + 0.1 + i * (bodyHeight / 3);

    const glassWallMat = new THREE.MeshPhysicalMaterial({
      color: 0xffffff,
      roughness: 0.05,
      metalness: 0.0,
      transmission: 0.95,
      thickness: 0.5,
      ior: 1.52,
      transparent: true,
      opacity: 0.3,
      side: THREE.DoubleSide,
    });

    // Front wall
    const frontWall = new THREE.Mesh(
      new THREE.BoxGeometry(chamberWidth, chamberHeight, wallThickness),
      glassWallMat
    );
    frontWall.position.set(0, y + chamberHeight / 2, bodyDepth / 2 - chamberDepth / 2 - wallThickness / 2);
    dispenser.add(frontWall);

    // Back wall
    const backWall = new THREE.Mesh(
      new THREE.BoxGeometry(chamberWidth, chamberHeight, wallThickness),
      glassWallMat
    );
    backWall.position.set(0, y + chamberHeight / 2, -bodyDepth / 2 + chamberDepth / 2 + wallThickness / 2);
    dispenser.add(backWall);

    // Side walls
    const sideWall = new THREE.Mesh(
      new THREE.BoxGeometry(wallThickness, chamberHeight, chamberDepth),
      glassWallMat
    );
    sideWall.position.set(-bodyWidth / 2 + chamberWidth / 2 + wallThickness / 2, y + chamberHeight / 2, 0);
    dispenser.add(sideWall);

    const sideWall2 = sideWall.clone();
    sideWall2.position.x = bodyWidth / 2 - chamberWidth / 2 - wallThickness / 2;
    dispenser.add(sideWall2);

    // Bottom
    const bottom = new THREE.Mesh(
      new THREE.BoxGeometry(chamberWidth, wallThickness, chamberDepth),
      glassWallMat
    );
    bottom.position.set(0, y, 0);
    dispenser.add(bottom);

    // Liquid inside
    const fillHeight = chamberHeight * fillLevels[i];
    const liquidGeom = new THREE.BoxGeometry(
      (chamberWidth - wallThickness * 2) * 0.95,
      fillHeight,
      (chamberDepth - wallThickness * 2) * 0.95
    );
    const liquid = new THREE.Mesh(liquidGeom, chamberMaterials[i]);
    liquid.position.set(0, y - chamberHeight / 2 + fillHeight / 2, 0);
    dispenser.add(liquid);

    // Bubbles for soap and foam
    if (i < 2) {
      const bubbleCount = i === 0 ? 12 : 8;
      const bubbleGroup = new THREE.Group();
      for (let b = 0; b < bubbleCount; b++) {
        const bubbleSize = 0.015 + Math.random() * 0.02;
        const bubbleGeom = new THREE.SphereGeometry(bubbleSize, 8, 8);
        const bubbleMat = new THREE.MeshPhysicalMaterial({
          color: chamberMaterials[i].color,
          roughness: 0.1,
          metalness: 0.0,
          transmission: 0.9,
          thickness: 0.5,
          transparent: true,
          opacity: 0.7,
        });
        const bubble = new THREE.Mesh(bubbleGeom, bubbleMat);
        bubble.position.set(
          (Math.random() - 0.5) * (chamberWidth - wallThickness * 2) * 0.7,
          y - chamberHeight / 2 + fillHeight - Math.random() * fillHeight * 0.6,
          (Math.random() - 0.5) * (chamberDepth - wallThickness * 2) * 0.7
        );
        bubble.userData = {
          originalY: bubble.position.y,
          speed: 0.0005 + Math.random() * 0.001,
          phase: Math.random() * Math.PI * 2,
          size: bubbleSize,
        };
        bubbleGroup.add(bubble);
      }
      dispenser.add(bubbleGroup);
      liquid.userData.bubbles = bubbleGroup;
    }

    // Chamber label
    const labelText = locale === 'de'
      ? (i === 0 ? 'SEIFE' : i === 1 ? 'SCHAUM' : 'PASTE')
      : (i === 0 ? 'SOAP' : i === 1 ? 'FOAM' : 'PASTE');
    const labelColor = [0x475569, 0xc2410c, 0xd97706][i];

    const labelBg = new THREE.Mesh(
      new THREE.PlaneGeometry(0.35, 0.08),
      new THREE.MeshBasicMaterial({
        color: labelColor,
        transparent: true,
        opacity: 0.15,
        side: THREE.DoubleSide,
      })
    );
    labelBg.position.set(0, y + chamberHeight / 2 + 0.06, bodyDepth / 2 - chamberDepth / 2 - 0.01);
    dispenser.add(labelBg);
  }

  // Control panel at bottom
  const panelHeight = 0.16;
  const panelWidth = bodyWidth * 0.8;
  const panelDepth = bodyDepth * 0.7;
  const panelGeom = new THREE.BoxGeometry(panelWidth, panelHeight, panelDepth);
  panelGeom.center();
  const panel = new THREE.Mesh(panelGeom, blackPlastic);
  panel.position.set(0, -bodyHeight / 2 + panelHeight / 2 + 0.05, bodyDepth / 2 - panelDepth / 2 - 0.02);
  panel.castShadow = true;
  dispenser.add(panel);

  // Mode LEDs on panel
  const ledPositions = [-0.22, 0, 0.22];
  const ledMeshes = [];
  for (let i = 0; i < 3; i++) {
    const ringGeom = new THREE.RingGeometry(0.018, 0.028, 32);
    const ringMat = new THREE.MeshBasicMaterial({
      color: [0x475569, 0xc2410c, 0xd97706][i],
      side: THREE.DoubleSide,
      transparent: true,
      opacity: 0.3,
    });
    const ringMesh = new THREE.Mesh(ringGeom, ringMat);
    ringMesh.position.set(ledPositions[i], -bodyHeight / 2 + panelHeight / 2 + 0.07, bodyDepth / 2 - panelDepth / 2 + 0.01);
    ringMesh.rotation.x = -Math.PI / 2;
    dispenser.add(ringMesh);
    ledMeshes.push({ mesh: ringMesh, color: [0x4a9b7a, 0x06b6d4, 0xf59e0b][i] });
  }

  // Main button on panel
  const btnGeom = new THREE.CylinderGeometry(0.055, 0.055, 0.018, 32);
  const btnMat = new THREE.MeshPhysicalMaterial({
    color: 0x334155,
    roughness: 0.3,
    metalness: 0.1,
    clearcoat: 1,
    clearcoatRoughness: 0.1,
  });
  const btn = new THREE.Mesh(btnGeom, btnMat);
  btn.position.set(0, -bodyHeight / 2 + panelHeight / 2 + 0.07, bodyDepth / 2 - panelDepth / 2 - 0.015);
  btn.rotation.x = -Math.PI / 2;
  dispenser.add(btn);

  // Button label "M"
  const btnLabel = new THREE.Mesh(
    new THREE.PlaneGeometry(0.04, 0.04),
    new THREE.MeshBasicMaterial({ color: 0xffffff, side: THREE.DoubleSide })
  );
  btnLabel.position.set(0, -bodyHeight / 2 + panelHeight / 2 + 0.071, bodyDepth / 2 - panelDepth / 2 - 0.016);
  btnLabel.rotation.x = -Math.PI / 2;
  dispenser.add(btnLabel);

  // Nozzles at bottom
  for (let i = 0; i < 3; i++) {
    const nozzleX = ledPositions[i];
    const nozzleGeom = new THREE.CylinderGeometry(0.012, 0.018, 0.04, 16);
    const nozzleMat = new THREE.MeshPhysicalMaterial({
      color: [0x475569, 0xc2410c, 0xd97706][i],
      roughness: 0.2,
      metalness: 0.0,
    });
    const nozzle = new THREE.Mesh(nozzleGeom, nozzleMat);
    nozzle.position.set(nozzleX, -bodyHeight / 2 - 0.01, bodyDepth / 2 + 0.015);
    dispenser.add(nozzle);
  }

  // USB-C port on side
  const usbGeom = new THREE.BoxGeometry(0.03, 0.012, 0.018);
  const usb = new THREE.Mesh(usbGeom, blackPlastic);
  usb.position.set(bodyWidth / 2 + 0.01, -bodyHeight / 2 + 0.4, 0);
  dispenser.add(usb);

  // Mounting bracket back
  const bracketGeom = new THREE.BoxGeometry(0.04, 1.8, 0.03);
  const bracketMat = new THREE.MeshPhysicalMaterial({
    color: 0xd6d3d1,
    roughness: 0.3,
    metalness: 0.8,
  });
  const bracket = new THREE.Mesh(bracketGeom, bracketMat);
  bracket.position.set(-bodyWidth / 2 - 0.06, 0, 0);
  bracket.castShadow = true;
  dispenser.add(bracket);

  // Mounting holes
  for (const hy of [-0.7, 0, 0.7]) {
    const holeGeom = new THREE.CylinderGeometry(0.015, 0.015, 0.04, 16);
    const holeMat = new THREE.MeshBasicMaterial({ color: 0x1a1a1a });
    const hole = new THREE.Mesh(holeGeom, holeMat);
    hole.position.set(-bodyWidth / 2 - 0.06, hy, 0);
    hole.rotation.x = Math.PI / 2;
    dispenser.add(hole);
  }

  // 3-in-1 badge
  const badgeGeom = new THREE.CylinderGeometry(0.12, 0.12, 0.01, 32);
  const badgeMat = new THREE.MeshPhysicalMaterial({
    color: 0x334155,
    roughness: 0.2,
    metalness: 0.1,
    clearcoat: 1,
    clearcoatRoughness: 0.1,
  });
  const badge = new THREE.Mesh(badgeGeom, badgeMat);
  badge.position.set(bodyWidth / 2 + 0.22, 0.5, 0);
  dispenser.add(badge);

  // Floor shadow catcher
  const floorGeom = new THREE.PlaneGeometry(4, 4);
  const floorMat = new THREE.ShadowMaterial({ opacity: 0.15 });
  const floor = new THREE.Mesh(floorGeom, floorMat);
  floor.rotation.x = -Math.PI / 2;
  floor.position.y = -bodyHeight / 2 - 0.02;
  floor.receiveShadow = true;
  scene.add(floor);

  // Add dispenser to scene
  scene.add(dispenser);

  // Fade in canvas once first frame rendered
  renderer.setAnimationLoop(() => {
    if (canvas.style.opacity !== '1') {
      canvas.style.opacity = '1';
    }
    if (skeleton) {
      skeleton.style.opacity = '0';
      setTimeout(() => {
        if (skeleton && skeleton.parentNode) skeleton.parentNode.removeChild(skeleton);
      }, 500);
    }
    controls.update();
    renderer.render(scene, camera);

    // Animate LED
    const time = performance.now() * 0.001;
    const ledColors = [0x475569, 0xc2410c, 0xd97706];
    const ledIndex = Math.floor((time / 2) % 3);
    led.material.color.setHex(ledColors[ledIndex]);
    const pulseScale = 1 + Math.sin(time * 5) * 0.1;
    led.scale.setScalar(pulseScale);

    ledMeshes.forEach((lm, i) => {
      const pulse = 1 + Math.sin(time * 3 + i * 1.5) * 0.3;
      lm.mesh.scale.setScalar(pulse);
      lm.mesh.material.opacity = 0.2 + 0.4 * Math.sin(time * 3 + i * 1.5);
    });

    const btnPulse = 1 + Math.sin(time * 1.5) * 0.02;
    btn.scale.setScalar(btnPulse);

    dispenser.children.forEach((child) => {
      if (child.userData.bubbles) {
        child.userData.bubbles.children.forEach((bubble) => {
          bubble.position.y += bubble.userData.speed;
          bubble.position.x += Math.sin(time * 2 + bubble.userData.phase) * 0.0003;
          if (bubble.position.y > child.position.y + chamberHeight / 2) {
            bubble.position.y = child.position.y - chamberHeight / 2 + fillLevels[0] * 0.1;
          }
        });
      }
    });

    if (controls.autoRotate) {
      dispenser.rotation.y += 0.0005;
    }
  });

  // Handle resize
  const handleResize = () => {
    const width = container.clientWidth;
    const height = container.clientHeight;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
  };
  window.addEventListener('resize', handleResize);

  // Pause auto-rotate on interaction
  canvas.addEventListener('pointerdown', () => {
    controls.autoRotate = false;
  });

  canvas.addEventListener('pointerup', () => {
    setTimeout(() => {
      controls.autoRotate = true;
    }, 2000);
  });

  // Cleanup on unload
  window.addEventListener('beforeunload', () => {
    window.removeEventListener('resize', handleResize);
    renderer.dispose();
  });
</script>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    [data-dispenser-3d] canvas {
      display: none;
    }
    [data-dispenser-3d]::after {
      content: '3D-Modell deaktiviert (reduzierte Bewegung)';
      display: block;
      text-align: center;
      padding: 2rem;
      color: var(--color-neutral-500);
    }
  }
</style>
