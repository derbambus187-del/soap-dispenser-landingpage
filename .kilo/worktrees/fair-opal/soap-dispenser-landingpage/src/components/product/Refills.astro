---
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';

interface RefillItem {
  name: string;
  size: string;
  price: string;
  color: string;
}

interface Props {
  locale: 'de' | 'en';
  title: string;
  items: RefillItem[];
}

const colorMap: Record<string, string> = {
  brand: 'bg-brand-100 text-brand-700 dark:bg-brand-900/30 dark:text-brand-300',
  teal: 'bg-accent-100 text-accent-700 dark:bg-accent-900/30 dark:text-accent-300',
  amber: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300',
  emerald: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300',
};

const subtitle = Astro.props.locale === 'de'
  ? 'Original-Nachfüllpacks für optimale Dosiergenauigkeit und Materialschonung.'
  : 'Original refill packs for optimal dosing accuracy and material care.';
const buttonLabel = Astro.props.locale === 'de' ? 'Nachfüllen' : 'Refill';
---

<Section class="bg-white dark:bg-neutral-950" padding="lg">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16 animate-in">
      <h2 class="font-display text-display-md font-bold text-neutral-900 dark:text-neutral-50 mb-4">
        {Astro.props.title}
      </h2>
      <p class="text-body-lg text-neutral-600 dark:text-neutral-400">
        {subtitle}
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
      {Astro.props.items.map((item, index) => (
        <article class="group card p-6 animate-in stagger-{index + 1}">
          <div class="w-14 h-14 rounded-xl bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform duration-300">
            <Icon name="package" size={28} class="text-brand-600 dark:text-brand-400" aria-hidden="true" />
          </div>
          <h3 class="font-display text-heading-md font-semibold text-neutral-900 dark:text-neutral-50 mb-1">
            {item.name}
          </h3>
          <p class="text-body-sm text-neutral-500 dark:text-neutral-400 mb-4">
            {item.size}
          </p>
          <div class="flex items-baseline justify-between mb-4">
            <span class="font-display text-display-sm font-bold text-neutral-900 dark:text-neutral-50">
              {item.price}
            </span>
            <Badge variant="default" class={colorMap[item.color] || 'bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300'}>
              {item.color}
            </Badge>
          </div>
          <Button variant="secondary" class="w-full" href="/kontakt">
            {buttonLabel}
          </Button>
        </article>
      ))}
    </div>
  </div>
</Section>