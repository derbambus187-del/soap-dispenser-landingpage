---
import { cx } from 'class-variance-authority';

interface Props {
  images: Array<{ src: string; alt: string }>;
  locale: 'de' | 'en';
}

const { images, locale } = Astro.props;

const viewLabels = [
  { de: 'Frontansicht', en: 'Front view' },
  { de: 'Seitenansicht', en: 'Side view' },
  { de: 'Rückansicht mit Montage', en: 'Rear view with mounting' },
];

const viewIcons = ['droplet', 'circle', 'layout-grid'];
---

<div class="gallery grid grid-cols-2 md:grid-cols-3 gap-4" role="list">
  {images.map((img, i) => {
    const label = viewLabels[i] || { de: 'Ansicht', en: 'View' };
    return (
      <article
        class={cx(
          'group relative overflow-hidden rounded-2xl bg-neutral-100 dark:bg-neutral-800 aspect-square cursor-pointer border border-neutral-200 dark:border-neutral-800 transition-all duration-300 ease-spring',
          i === 0 && 'md:col-span-2 md:row-span-2',
          'hover:border-brand-600/50 hover:shadow-md'
        )}
        role="listitem"
      >
        <!-- SVG placeholder shape instead of image -->
        <div class="w-full h-full flex items-center justify-center bg-neutral-200 dark:bg-neutral-700/50 relative overflow-hidden">
          <svg
            class="w-16 h-16 text-neutral-400 dark:text-neutral-600 group-hover:text-brand-600 transition-colors duration-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {viewIcons[i] === 'droplet' ? (
              <>
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31-11.31z" />
                <line x1="12" y1="12" x2="12" y2="21" />
              </>
            ) : viewIcons[i] === 'circle' ? (
              <circle cx="12" cy="12" r="10" />
            ) : (
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            )}
          </svg>
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
            <span class="text-white font-medium text-sm w-full">
              {locale === 'de' ? label.de : label.en}
            </span>
          </div>
        </div>
      </article>
    );
  })}
</div>
