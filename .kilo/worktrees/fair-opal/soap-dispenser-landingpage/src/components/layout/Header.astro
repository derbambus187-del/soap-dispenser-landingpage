---
import Icon from '@/components/ui/Icon.astro';
import { getAlternatePath } from '@/i18n/utils';
import { cx } from 'class-variance-authority';

interface Props {
  locale: 'de' | 'en';
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

const navLinks = [
  { label: locale === 'de' ? 'Startseite' : 'Home', href: `/${locale}/` },
  { label: locale === 'de' ? 'Funktionen' : 'Features', href: `/${locale}/funktionen/` },
  { label: locale === 'de' ? 'Anwendung' : 'Usage', href: `/${locale}/anwendung/` },
  { label: locale === 'de' ? 'FAQ' : 'FAQ', href: `/${locale}/faq/` },
  { label: locale === 'de' ? 'Kontakt' : 'Contact', href: `/${locale}/kontakt/` },
];

const otherLocale = locale === 'de' ? 'en' : 'de';
const switcherHref = getAlternatePath(currentPath, otherLocale);
const switcherLabel = otherLocale === 'de' ? 'Deutsch' : 'English';
---

<header class="sticky top-0 z-50 glass border-b border-neutral-200 dark:border-neutral-800" data-header>
  <div class="container-page flex items-center justify-between h-16 md:h-18">
    <!-- Logo -->
    <a href={`/${locale}/`} class="flex items-center gap-2 font-display font-bold text-xl text-neutral-900 dark:text-neutral-50">
      <div class="w-9 h-9 rounded-lg bg-brand-600 flex items-center justify-center">
        <Icon name="droplet" size={22} class="text-white" aria-hidden="true" />
      </div>
      <span>3-in-1</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Hauptnavigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={cx(
              'px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 ease-spring',
              isActive
                ? 'text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-900/20'
                : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800'
            )}
            aria-current={isActive ? 'page' : 'false'}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-2">
      <!-- Language switcher -->
      <a
        href={switcherHref}
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        aria-label={locale === 'de' ? 'Sprache auf English wechseln' : 'Switch language to German'}
        title={switcherLabel}
      >
        <Icon name="globe" size={18} aria-hidden="true" />
        <span>{switcherLabel}</span>
      </a>

      <!-- Dark mode toggle -->
      <button
        class="p-2 rounded-lg text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        aria-label="Dark mode umschalten"
        data-theme-toggle
      >
        <Icon name="sun" size={20} class="dark:hidden" aria-hidden="true" />
        <Icon name="moon" size={20} class="hidden dark:block" aria-hidden="true" />
      </button>

      <!-- Mobile menu button -->
      <button
        class="md:hidden p-2 rounded-lg text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800"
        aria-label="Menü öffnen"
        aria-expanded="false"
        data-mobile-menu
      >
        <Icon name="menu" size={24} aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="md:hidden hidden border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950" data-mobile-menu-panel>
    <nav class="container-page py-4 flex flex-col gap-1" aria-label="Mobile Navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={cx(
              'px-3 py-2.5 rounded-lg text-base font-medium transition-colors',
              isActive
                ? 'text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-900/20'
                : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800'
            )}
            aria-current={isActive ? 'page' : 'false'}
          >
            {link.label}
          </a>
        );
      })}
      <a
        href={switcherHref}
        class="px-3 py-2.5 rounded-lg text-base font-medium text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors flex items-center gap-2"
      >
        <Icon name="globe" size={18} aria-hidden="true" />
        {switcherLabel}
      </a>
    </nav>
  </div>
</header>

<!-- Scroll-to-top button -->
<button
  class="fixed right-6 bottom-6 z-40 w-12 h-12 rounded-full bg-brand-600 text-white shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 ease-spring transform translate-y-10 hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/40"
  aria-label={locale === 'de' ? 'Nach oben scrollen' : 'Scroll to top'}
  data-scroll-top
>
  <Icon name="chevron-up" size={20} aria-hidden="true" />
</button>

<script>
  const btn = document.querySelector('[data-mobile-menu]');
  const panel = document.querySelector('[data-mobile-menu-panel]');
  if (btn && panel) {
    btn.addEventListener('click', () => {
      const isOpen = panel.classList.contains('flex');
      if (isOpen) {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        panel.classList.remove('hidden');
        panel.classList.add('flex');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
    panel.addEventListener('click', (e) => {
      if (e.target.tagName === 'A') {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<script is:inline>
  (function() {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = stored ? stored === 'dark' : prefersDark;
    document.documentElement.classList.toggle('dark', isDark);
  })();
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('[data-theme-toggle]');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }

    // Scroll-to-top
    const topBtn = document.querySelector('[data-scroll-top]');
    if (topBtn) {
      const update = () => {
        if (window.scrollY > 300) {
          topBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
          topBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        } else {
          topBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
          topBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        }
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
      topBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Intersection Observer fade-in on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.animate-in').forEach((el) => observer.observe(el));
  });
</script>

<style>
  .animate-in {
    animation: none !important;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 400ms cubic-bezier(0.34, 1.56, 0.64, 1), transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .animate-in.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .animate-in.stagger-1 { transition-delay: 100ms; }
  .animate-in.stagger-2 { transition-delay: 200ms; }
  .animate-in.stagger-3 { transition-delay: 300ms; }
  .animate-in.stagger-4 { transition-delay: 400ms; }
  .animate-in.stagger-5 { transition-delay: 500ms; }
  .animate-in.stagger-6 { transition-delay: 600ms; }
</style>
