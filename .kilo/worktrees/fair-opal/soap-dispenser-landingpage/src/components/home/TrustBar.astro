---
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  locale: 'de' | 'en';
  data: {
    trust: {
      badges: string[];
      reviews: string;
    };
  };
}

const { locale, data } = Astro.props;
const { trust } = data;
const [rating, ...reviewRest] = trust.reviews.split(' ');
---

<Section class="bg-neutral-50 dark:bg-neutral-900/50 border-y border-neutral-200 dark:border-neutral-800" padding="md">
  <div class="container-page">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Reviews -->
      <div class="flex items-center gap-4 animate-in">
        <div class="flex -space-x-2" role="img" aria-label={locale === 'de' ? '5 Sterne Bewertung' : '5 star rating'}>
          {Array.from({ length: 5 }).map((_, i) => (
            <div key={i} class="w-8 h-8 rounded-full bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-xs font-semibold text-brand-600 dark:text-brand-400 border-2 border-white dark:border-neutral-900">
              ★
            </div>
          ))}
        </div>
        <div>
          <p class="font-display text-display-sm font-bold text-neutral-900 dark:text-neutral-50">
            {rating}
          </p>
          <p class="text-body-sm text-neutral-600 dark:text-neutral-400">
            {reviewRest.join(' ')}
          </p>
        </div>
      </div>

      <!-- Badges -->
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-4 animate-in stagger-1">
        {trust.badges.map((badge) => (
          <Badge key={badge} variant="brand" class="px-3 py-1.5 text-sm">
            <Icon name="shield-check" size={14} class="mr-1.5" aria-hidden="true" />
            {badge}
          </Badge>
        ))}
      </div>
    </div>
  </div>
</Section>
