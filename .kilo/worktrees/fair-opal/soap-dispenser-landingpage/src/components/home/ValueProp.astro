---
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import Card from '@/components/ui/Card.astro';

interface Props {
  locale: 'de' | 'en';
  data: {
    valueProps: Array<{
      icon: string;
      title: string;
      desc: string;
    }>;
  };
}

const { locale, data } = Astro.props;
const { valueProps } = data;
---

<Section class="bg-neutral-50 dark:bg-neutral-900/50" padding="lg">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16 animate-in">
      <h2 class="font-display text-display-lg font-bold text-neutral-900 dark:text-neutral-50 mb-4">
        {locale === 'de' ? 'Drei Kammern. Ein System.' : 'Three chambers. One system.'}
      </h2>
      <p class="text-body-lg text-neutral-600 dark:text-neutral-400">
        {locale === 'de'
          ? 'Jede Kammer ist präzise für eine bestimmte Konsistenz und Nutzung optimiert.'
          : 'Each chamber is precisely optimized for a specific consistency and use.'}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {valueProps.map((vp, index) => (
        <article class="group animate-in stagger-{index + 1}">
          <Card class="h-full transition-shadow duration-300 ease-spring group-hover:shadow-md hover:border-brand-600/50">
            <div class="w-14 h-14 rounded-xl bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 ease-spring">
              <Icon name={vp.icon} size={28} class="text-brand-600 dark:text-brand-400" aria-hidden="true" />
            </div>
            <h3 class="font-display text-heading-lg font-semibold text-neutral-900 dark:text-neutral-50 mb-3">
              {vp.title}
            </h3>
            <p class="text-body text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {vp.desc}
            </p>
          </Card>
        </article>
      ))}
    </div>
  </div>
</Section>
