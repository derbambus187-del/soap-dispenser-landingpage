---
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';

interface Props {
  locale: 'de' | 'en';
  data: {
    hero: {
      headline: string;
      subheadline: string;
      ctaPrimary: { label: string; href: string };
      ctaSecondary: { label: string; href: string };
    };
    valueProps?: Array<{ icon: string; title: string; desc: string }>;
    techSpecs?: Array<{ label: string; value: string }>;
    productImage?: string;
  };
}

const { locale, data } = Astro.props;
const { hero } = data;
---

<Section class="relative overflow-hidden" padding="lg">
  <!-- Subtle animated gradient background (no blobs) -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-25 to-neutral-50 dark:from-neutral-950 dark:to-neutral-900" />
    <div
      class="absolute inset-0 opacity-40"
      style="background: linear-gradient(135deg, rgba(71, 85, 105, 0.08) 0%, rgba(71, 85, 105, 0) 40%, rgba(71, 85, 105, 0.04) 70%, transparent 100%); background-size: 200% 200%; animation: hero-gradient 10s ease-in-out infinite alternate;"
    />
  </div>

  <div class="container-page relative">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text content -->
      <div class="max-w-xl animate-in">
        <Badge variant="brand" class="mb-6 inline-flex">
          <Icon name="sparkles" size={14} aria-hidden="true" />
          <span>{locale === 'de' ? 'Neu: 3-in-1 System' : 'New: 3-in-1 System'}</span>
        </Badge>
        <h1 class="font-display text-display-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 mb-6">
          {hero.headline}
        </h1>
        <p class="text-body-lg text-neutral-600 dark:text-neutral-400 mb-8 max-w-lg">
          {hero.subheadline}
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href={hero.ctaPrimary.href} variant="primary" size="lg">
            {hero.ctaPrimary.label}
          </Button>
          <Button href={hero.ctaSecondary.href} variant="secondary" size="lg">
            <Icon name="play" size={20} aria-hidden="true" />
            {hero.ctaSecondary.label}
          </Button>
        </div>

        <!-- Trust indicators -->
        <div class="mt-10 flex flex-wrap items-center gap-5 text-sm text-neutral-500 dark:text-neutral-400">
          <span class="flex items-center gap-1.5">
            <Icon name="truck" size={16} aria-hidden="true" />
            {locale === 'de' ? 'Kostenloser Versand' : 'Free shipping'}
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="shield-check" size={16} aria-hidden="true" />
            {locale === 'de' ? '30 Tage Rückgabe' : '30-day returns'}
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="rotate-ccw" size={16} aria-hidden="true" />
            {locale === 'de' ? '2 Jahre Garantie' : '2-year warranty'}
          </span>
        </div>
      </div>

      <!-- Product visual (SVG, no images) -->
      <div class="relative animate-in stagger-1">
        <div class="w-full max-w-md mx-auto">
          <svg
            class="w-full h-auto drop-shadow-sm"
            viewBox="0 0 200 260"
            xmlns="http://www.w3.org/2000/svg"
            aria-label={locale === 'de' ? '3-in-1 Seifenspender' : '3-in-1 Soap Dispenser'}
            role="img"
          >
            <defs>
              <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#e7e5e4" />
              </linearGradient>
              <linearGradient id="liq1" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#475569" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#475569" stop-opacity="0.55" />
              </linearGradient>
              <linearGradient id="liq2" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#334155" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#334155" stop-opacity="0.55" />
              </linearGradient>
              <linearGradient id="liq3" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#d97706" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#d97706" stop-opacity="0.55" />
              </linearGradient>
            </defs>

            <!-- Body -->
            <path
              d="M 30 40 Q 30 10 70 10 L 130 10 Q 170 10 170 40 L 170 220 Q 170 250 130 250 L 70 250 Q 30 250 30 220 Z"
              fill="url(#bodyGrad)"
              stroke="#c9e4da"
              stroke-width="2"
            />
            <!-- Cap -->
            <path d="M 55 40 L 55 28 Q 70 10 145 10 L 145 28 Z" fill="#1c1917" />
            <path d="M 70 22 Q 70 12 100 12 Q 130 12 130 22 Z" fill="#2f2a27" />
            <!-- Sensor ring -->
            <ellipse cx="100" cy="24" rx="14" ry="5" fill="none" stroke="#c8c8c8" stroke-width="3" />
            <!-- LED -->
            <circle cx="100" cy="22" r="2.5" fill="#d97706" />

            <!-- Chamber dividers -->
            <line x1="30" y1="110" x2="170" y2="110" stroke="#c9e4da" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.6" />
            <line x1="30" y1="180" x2="170" y2="180" stroke="#c9e4da" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.6" />

            <!-- Chambers -->
            <rect x="50" y="50" width="100" height="55" fill="none" stroke="#e7e5e4" stroke-width="1.5" />
            <rect x="55" y="55" width="90" height="32" fill="url(#liq1)" />
            <rect x="50" y="118" width="100" height="55" fill="none" stroke="#e7e5e4" stroke-width="1.5" />
            <rect x="55" y="123" width="90" height="30" fill="url(#liq2)" />
            <rect x="50" y="184" width="100" height="55" fill="none" stroke="#e7e5e4" stroke-width="1.5" />
            <rect x="55" y="189" width="90" height="26" fill="url(#liq3)" />

            <!-- Nozzles -->
            <circle cx="70" cy="242" r="3" fill="#475569" />
            <circle cx="100" cy="242" r="3" fill="#334155" />
            <circle cx="130" cy="242" r="3" fill="#d97706" />

            <!-- Panel button -->
            <rect x="90" y="228" width="20" height="6" rx="3" fill="#334155" />
          </svg>
          <p class="text-center mt-6 text-body-sm text-neutral-500 dark:text-neutral-400 font-medium">
            {locale === 'de' ? '3-in-1 Seifenspender' : '3-in-1 Soap Dispenser'}
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  @keyframes hero-gradient {
    0% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }
</style>
