---
import Layout from '@/components/layout/Layout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import faqData from '@/content/en/faq.json';

const locale = 'en';
const currentPath = '/en/faq';
const { faq } = faqData;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
};
---

<BaseLayout
  title="FAQ – 3-in-1 Soap Dispenser"
  description="Frequently asked questions about the 3-in-1 Soap Dispenser: Refilling, Compatibility, Battery, Mounting, Warranty, Shipping, Shower, Dosing."
  locale={locale}
  jsonLd={[jsonLd]}
>
  <Layout locale={locale} currentPath={currentPath}>
    <!-- Hero -->
    <section class="bg-slate-900 dark:bg-black text-white py-16 md:py-24">
      <div class="container-page">
        <div class="max-w-3xl">
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            Frequently Asked Questions.
          </h1>
          <p class="text-xl text-slate-300">
            Find answers to the most common questions here. Not listed? Contact us!
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <Section padding="xl" class="bg-white dark:bg-slate-950">
      <div class="container-page max-w-3xl mx-auto">
        <div class="space-y-4" id="faq-accordion">
          {faq.map((item, i) => (
            <details class="group border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden bg-slate-50 dark:bg-slate-900/50">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                <h3 class="font-semibold text-lg text-slate-900 dark:text-white pr-8">
                  {item.question}
                </h3>
                <Icon name="chevron-down" size={20} class="text-slate-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" />
              </summary>
              <div class="px-6 pb-6 text-slate-600 dark:text-slate-400 leading-relaxed" set:html={item.answer} />
            </details>
          ))}
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section padding="xl" class="bg-slate-50 dark:bg-slate-900/50">
      <div class="container-page text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">
          More questions?
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 mb-8 max-w-xl mx-auto">
          Our support team is happy to help – via email or phone.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="mailto:info@seifenspender.example" class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium bg-brand-600 text-white rounded-lg hover:bg-brand-700 transition-colors">
            <Icon name="mail" size={18} aria-label="" />
            Write Email
          </a>
          <a href="tel:+491234567890" class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
            <Icon name="phone" size={18} aria-label="" />
            Call Us
          </a>
        </div>
      </div>
    </Section>
  </Layout>
</BaseLayout>