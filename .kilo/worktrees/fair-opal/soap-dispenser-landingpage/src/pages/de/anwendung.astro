---
import Layout from '@/components/layout/Layout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import usageData from '@/content/de/usage.json';

const locale = 'de';
const currentPath = '/de/anwendung';
const { steps, tips } = usageData;
---

<BaseLayout
  title="Anwendung – 3-in-1 Seifenspender"
  description="Schritt-für-Schritt-Anleitung: Auspacken, Laden, Befüllen, Montieren, Einstellen, Loslegen. Tipps & Tricks für optimale Nutzung."
  locale={locale}
>
  <Layout locale={locale} currentPath={currentPath}>
    <!-- Hero -->
    <section class="bg-slate-900 dark:bg-black text-white py-16 md:py-24">
      <div class="container-page">
        <div class="max-w-3xl">
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            {locale === 'de' ? 'In 5 Minuten startklar.' : 'Ready in 5 minutes.'}
          </h1>
          <p class="text-xl text-slate-300">
            {locale === 'de'
              ? 'So einfach geht die Einrichtung – ganz ohne Handwerker.'
              : 'Setup is this easy – no handyman needed.'}
          </p>
        </div>
      </div>
    </section>

    <!-- Steps -->
    <Section padding="xl" class="bg-white dark:bg-slate-950">
      <div class="container-page">
        <div class="max-w-4xl mx-auto">
          {steps.map((step, i) => (
            <div class="flex gap-6 md:gap-8 mb-12 md:mb-16 last:mb-0" key={step.number}>
              <div class="flex-shrink-0 w-14 h-14 rounded-full bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center font-display text-2xl font-bold text-brand-600 dark:text-brand-400">
                {step.number}
              </div>
              <div class="flex-1 pt-1">
                <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white mb-3">
                  {step.title}
                </h2>
                <div class="prose prose-slate dark:prose-invert max-w-none" set:html={step.desc} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <!-- Tips -->
    <Section padding="xl" class="bg-slate-50 dark:bg-slate-900/50">
      <div class="container-page">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">
            {locale === 'de' ? 'Tipps & Tricks' : 'Tips & Tricks'}
          </h2>
          <p class="text-lg text-slate-600 dark:text-slate-400">
            {locale === 'de'
              ? 'Für das beste Erlebnis und lange Lebensdauer.'
              : 'For the best experience and long lifespan.'}
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {tips.map((tip) => (
            <div class="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                  <Icon name={tip.icon} size={20} class="text-amber-600 dark:text-amber-400" aria-label="" />
                </div>
                <div>
                  <h3 class="font-semibold text-slate-900 dark:text-white mb-1">{tip.title}</h3>
                  <p class="text-slate-600 dark:text-slate-400">{tip.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section padding="xl" class="bg-brand-600 text-white">
      <div class="container-page text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">
          {locale === 'de' ? 'Bereit für Ihr 3-in-1 Erlebnis?' : 'Ready for your 3-in-1 experience?'}
        </h2>
        <p class="text-lg text-brand-100 mb-8 max-w-xl mx-auto">
          {locale === 'de'
            ? 'Bestellen Sie jetzt und genießen Sie hygienische, platzsparende Badhygiene ab morgen.'
            : 'Order now and enjoy hygienic, space-saving bathroom hygiene from tomorrow.'}
        </p>
        <a href="https://shop.seifenspender.example" class="inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold bg-white text-brand-600 rounded-lg hover:bg-brand-50 transition-colors">
          {locale === 'de' ? 'Jetzt bestellen' : 'Order Now'}
        </a>
      </div>
    </Section>
  </Layout>
</BaseLayout>